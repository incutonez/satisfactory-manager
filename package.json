{
  "name": "@incutonez/satisfactory",
  "private": true,
  "version": "2.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --mode=GitHubPages",
    "explode": "npm cache clean --force && npx rimraf package-lock.json **/node_modules --glob && npm i",
    "lint": "npx eslint --fix",
    "preview": "vite preview",
    "generate:items": "npx tsx src/generator.ts",
    "update:deps": "node ./updateDependencies.js",
    "update:versions": "node ./updateVersions.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@material-symbols/svg-400": "latest",
    "@reduxjs/toolkit": "^2.11.2",
    "@tanstack/react-router": "^1.157.18",
    "@tanstack/react-table": "^8.21.3",
    "@types/pluralize": "^0.0.33",
    "classnames": "^2.5.1",
    "just-camel-case": "^6.2.0",
    "just-capitalize": "^3.2.0",
    "just-clone": "^6.2.0",
    "just-safe-get": "^4.2.0",
    "mathjs": "^15.1.0",
    "mime-types": "^3.0.2",
    "pluralize": "^8.0.0",
    "react": "^19.2.4",
    "react-aria-components": "^1.14.0",
    "react-dom": "^19.2.4",
    "react-redux": "^9.2.0",
    "redux-thunk": "^3.1.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@faker-js/faker": "^10.2.0",
    "@incutonez/eslint-plugin": "latest",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@stylistic/eslint-plugin-ts": "latest",
    "@tailwindcss/vite": "latest",
    "@tanstack/router-plugin": "^1.157.18",
    "@types/mime-types": "^3.0.1",
    "@types/node": "latest",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "@vitejs/plugin-react": "^5.1.3",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "eslint": "latest",
    "eslint-plugin-react": "latest",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-simple-import-sort": "latest",
    "globals": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "semantic-release": "^25.0.3",
    "tailwindcss": "latest",
    "typescript": "~5.9.3",
    "typescript-eslint": "latest",
    "vite": "^7.3.1",
    "vite-plugin-svgr": "latest"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx,vue}": [
      "npx eslint --fix"
    ]
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  }
}
